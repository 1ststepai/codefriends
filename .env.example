# Copy to .env in the repo root (never commit .env).
# All values here are placeholders — do not invent or paste real secrets.

# --- Local SQLite (Node server / smoke) ---
# Default: apps/server/data/codefriends.sqlite (created on first run).
# Use a file path so data survives process restart. `:memory:` is ephemeral.
# CODEFRIENDS_DB=apps/server/data/codefriends.sqlite
# Windows self-host example (forward slashes are fine):
# CODEFRIENDS_DB=C:/codefriends-data/codefriends.sqlite

# --- Serve built popout from the Node API (same port as /api and /ws) ---
# On when apps/popout/dist/index.html exists. Override the folder if needed.
# Leave VITE_CODEFRIENDS_* unset so the SPA talks to this same origin.
# CODEFRIENDS_POPOUT_DIR=apps/popout/dist
# After a stable public hostname (named Cloudflare tunnel):
# CODEFRIENDS_PUBLIC_URL=https://codefriends.1ststep.ai
# CODEFRIENDS_POPOUT_URL=https://codefriends.1ststep.ai

# --- Optional Turso / libSQL (Node on Fly/Render so data survives sleep) ---
# Free Turso DB: https://turso.tech — paste the libsql URL + token, not a local path.
# CODEFRIENDS_LIBSQL_URL=libsql://YOUR-DB-YOUR-ORG.turso.io
# CODEFRIENDS_LIBSQL_AUTH_TOKEN=

# --- Public URLs (needed for OAuth redirects and CORS) ---
# CODEFRIENDS_PUBLIC_URL=http://127.0.0.1:8787
# CODEFRIENDS_POPOUT_URL=http://127.0.0.1:5173
# Extra browser origins, comma-separated (Vercel preview URLs, etc.)
# Tauri desktop custom-protocol origins (tauri://localhost, https://tauri.localhost, …)
# are already allow-listed in packages/core — no extra CORS var needed for the shell.
# CODEFRIENDS_CORS_ORIGINS=https://your-popout.vercel.app
# HOST=127.0.0.1
# PORT=8787

# --- Dev username login (no password) ---
# On by default when NODE_ENV is not production.
# Production (Vercel + Cloudflare) stays off unless you set =1.
# CODEFRIENDS_DEV_LOGIN=1
# CODEFRIENDS_DEV_LOGIN=0

# --- Architecture mocks (not real Cursor/Claude/Codex/Gemini login) ---
# Enables POST /api/auth/:provider/mock so the identity model can be tested
# without registering OAuth apps. Never enable in production.
# CODEFRIENDS_MOCK_PROVIDERS=1

# --- Email/phone anchor OTP ---
# Local/dev returns mockCode in the start JSON so you can finish without SMS/email.
# Production Worker keeps this off unless CODEFRIENDS_OTP_MOCK=1 (do not enable publicly).
# No SMS or email provider is wired yet — codes are stored hashed only.
# CODEFRIENDS_OTP_MOCK=1

# --- Seed roster (maya, parker, …). Set 0 to start empty. ---
# CODEFRIENDS_SEED=1

# --- 1:1 DM history cap (older rows pruned on write; default 200) ---
# CODEFRIENDS_DM_HISTORY_LIMIT=200

# =============================================================================
# Popout (Vite) — baked in at `npm run build -w @codefriends/popout`.
# Local `npm run dev` leaves these unset so the Vite proxy talks to :8787.
# On Vercel, set the same names in Project → Settings → Environment Variables
# *before* the first production deploy (then redeploy if you change them).
# =============================================================================
# VITE_CODEFRIENDS_API_URL=https://codefriends-api.YOUR-SUBDOMAIN.workers.dev
# VITE_CODEFRIENDS_WS_URL=wss://codefriends-api.YOUR-SUBDOMAIN.workers.dev/ws

# =============================================================================
# Gemini — the only provider with a public, implementable identity path today.
# Gemini consumer accounts are Google accounts. This is Sign in with Google
# (OIDC), not a separate “Gemini OAuth” product.
#
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client
#    Application type: Web application
# 2. Authorized redirect URI must match GEMINI_GOOGLE_CALLBACK_URL exactly
# 3. Fill the three vars below. Leave blank to keep the button “unconfigured”.
# =============================================================================
GEMINI_GOOGLE_CLIENT_ID=
GEMINI_GOOGLE_CLIENT_SECRET=
GEMINI_GOOGLE_CALLBACK_URL=http://127.0.0.1:8787/api/auth/gemini/callback

# =============================================================================
# Cursor / Claude / Codex — not wired as live OAuth.
# There is no public third-party identity API to register against yet.
# Do not add unofficial client ids or scraped session tokens here.
# See README “Provider status”.
# =============================================================================
