# Copy to .env in the repo root (never commit .env).
# All values here are placeholders — do not invent or paste real secrets.

# --- SQLite ---
# Default: apps/server/data/codefriends.sqlite (created on first run).
# Use a file path so data survives process restart. `:memory:` is ephemeral.
# CODEFRIENDS_DB=apps/server/data/codefriends.sqlite

# --- Public URLs (needed for OAuth redirects) ---
# CODEFRIENDS_PUBLIC_URL=http://127.0.0.1:8787
# CODEFRIENDS_POPOUT_URL=http://127.0.0.1:5173
# HOST=127.0.0.1
# PORT=8787

# --- Dev username login (no password) ---
# On by default when NODE_ENV is not production.
# CODEFRIENDS_DEV_LOGIN=1
# CODEFRIENDS_DEV_LOGIN=0

# --- Architecture mocks (not real Cursor/Claude/Codex/Gemini login) ---
# Enables POST /api/auth/:provider/mock so the identity model can be tested
# without registering OAuth apps. Never enable in production.
# CODEFRIENDS_MOCK_PROVIDERS=1

# --- Seed roster (maya, parker, …). Set 0 to start empty. ---
# CODEFRIENDS_SEED=1

# =============================================================================
# Gemini — the only provider with a public, implementable identity path today.
# Gemini consumer accounts are Google accounts. This is Sign in with Google
# (OIDC), not a separate “Gemini OAuth” product.
#
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client
#    Application type: Web application
# 2. Authorized redirect URI must match GEMINI_GOOGLE_CALLBACK_URL exactly
# 3. Fill the three vars below. Leave blank to keep the button “unconfigured”.
# =============================================================================
GEMINI_GOOGLE_CLIENT_ID=
GEMINI_GOOGLE_CLIENT_SECRET=
GEMINI_GOOGLE_CALLBACK_URL=http://127.0.0.1:8787/api/auth/gemini/callback

# =============================================================================
# Cursor / Claude / Codex — not wired as live OAuth.
# There is no public third-party identity API to register against yet.
# Do not add unofficial client ids or scraped session tokens here.
# See README “Provider status”.
# =============================================================================
