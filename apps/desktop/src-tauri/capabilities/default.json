{
  "identifier": "default",
  "description": "Main CodeFriends window (tray + deep links are handled in Rust)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-close",
    "core:tray:default",
    "core:menu:default",
    "window-state:default",
    "deep-link:default"
  ]
}
