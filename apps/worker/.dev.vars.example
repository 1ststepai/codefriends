# Copy to apps/worker/.dev.vars for `wrangler dev`. Never commit the real file.
# Production login is Google OIDC (GEMINI_GOOGLE_*). Callback URI must match the
# Google Cloud Web client exactly. Server CODEFRIENDS_POPOUT_URL must be http(s).
CODEFRIENDS_POPOUT_URL=http://127.0.0.1:5173
CODEFRIENDS_PUBLIC_URL=http://127.0.0.1:8787
CODEFRIENDS_DEV_LOGIN=1
CODEFRIENDS_SEED=1
CODEFRIENDS_MOCK_PROVIDERS=0
CODEFRIENDS_DM_HISTORY_LIMIT=200
GEMINI_GOOGLE_CLIENT_ID=
GEMINI_GOOGLE_CLIENT_SECRET=
GEMINI_GOOGLE_CALLBACK_URL=http://127.0.0.1:8787/api/auth/gemini/callback
